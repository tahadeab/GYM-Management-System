{
  "name": "gym-system",
  "version": "1.0.0",
  "description": "Professional bilingual desktop gym management system with Arabic and English support",
  "author": {
    "name": "tahadeab",
    "email": "tahadeab201@gmail.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 -m http.server 8080 || python -m http.server 8080",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "build": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis",
    "setup": "node database/improved_db.js",
    "test": "jest --runInBand",
    "test:unit": "jest --testPathPattern=tests/unit --runInBand",
    "test:integration": "jest --testPathPattern=tests/integration --runInBand",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "check": "for f in main.js preload.js database/*.js scripts/*.js; do node --check $f || exit 1; done",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "electron": "^37.2.5",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.5.0",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.3",
    "jspdf": "^3.0.1",
    "sqlite3": "^5.1.7",
    "validator": "^13.15.15",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.tahadeab.pulseforge.gym",
    "productName": "PulseForge Gym Management",
    "asar": true,
    "files": [
      "**/*",
      "!tests{,/**/*}",
      "!*.db",
      "!coverage{,/**/*}",
      "!*.log"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PulseForge-Gym-Management-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseForge Gym Management"
    }
  }
}